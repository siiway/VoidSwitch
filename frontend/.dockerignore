# Keep the build context lean and deterministic.
node_modules/
.nuxt/
.output/
dist/
tsconfig.tsbuildinfo

# Never bake local env into the build — NUXT_* vars would be inlined. The image
# relies on the same-origin fallback in nuxt/composables/useApi.ts instead.
.env
.env.*

.git/
.gitignore
Dockerfile
.dockerignore
README.md

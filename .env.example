# Copy to .env — docker compose reads it automatically.
# These map onto the VOIDSWITCH_* env vars the gateway consumes (see compose.yaml).

# Host port to publish the gateway on (Python stack, compose.yaml).
VOIDSWITCH_PORT=7292

# Host port for the Go stack (compose-go.yaml) — distinct so both can run at once.
# VOIDSWITCH_GO_PORT=7392

# Public base URL of the gateway. Set to your real origin when deployed behind a
# domain/reverse proxy — it builds the OAuth redirect_uri AND (single-origin) the
# post-login redirect target.
VOIDSWITCH_BASE_URL=http://localhost:8080

# Where the browser is sent after OAuth login (serves the SPA /login/callback).
# Defaults to VOIDSWITCH_BASE_URL — only set this if the dashboard is on a
# different origin than the gateway.
# VOIDSWITCH_FRONTEND_URL=https://voidswitch.siiway.org

# Stable JWT signing secret for dashboard sessions. Generate with:
#   openssl rand -base64 48
# Leave blank to auto-generate per container (sessions reset on recreation).
VOIDSWITCH_SECRET_KEY=

# Prism OAuth app (required for dashboard login).
VOIDSWITCH_PRISM_ISSUER=https://prism.siiway.org
VOIDSWITCH_PRISM_CLIENT_ID=your-prism-client-id
VOIDSWITCH_PRISM_CLIENT_SECRET=your-prism-client-secret

# Prism team whose owners/admins are recognised as VoidSwitch staff (main-team
# mapping). Both compose files default to the siiway team; override it here.
# VOIDSWITCH_MAIN_TEAM_ID=63d4761c78c2dec09a002233e1b7c06c

# Database. Default is SQLite on the named volume.
#  - Python stack (compose.yaml): a SQLAlchemy URL — keep the sqlite+aiosqlite://
#    prefix, e.g. sqlite+aiosqlite:////data/voidswitch.db
#  - Go stack (compose-go.yaml): a plain file path, e.g. /data/voidswitch.db
#    (it strips a sqlite+aiosqlite:// prefix if present).
# VOIDSWITCH_DATABASE_URL=sqlite+aiosqlite:////data/voidswitch.db

# Build-time proxy for `docker compose build` (uv/pip for the Python image, go
# mod download for the Go one). Leave unset for a direct connection.
# HTTP_PROXY=http://YOUR_PROXY:PORT
# HTTPS_PROXY=http://YOUR_PROXY:PORT
# NO_PROXY=localhost,127.0.0.1

# Data storing location (e.g. SQLite voidswtich.db), use a name without /
# to specify a docker volume, or with / to specify a path.
# DATA_DIR=./data/
# DATA_DIR=voidswitch-data
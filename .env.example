# Copy to .env — docker compose reads it automatically.
# These map onto the VOIDSWITCH_* env vars the gateway consumes (see compose.yaml).

# Host port to publish the dashboard (and proxied API) on.
VOIDSWITCH_PORT=7292

# Public base URL of the gateway. Set to your real origin when deployed behind a
# domain/reverse proxy — it builds the OAuth redirect_uri AND (single-origin) the
# post-login redirect target.
VOIDSWITCH_BASE_URL=http://localhost:8080

# Where the browser is sent after OAuth login (serves the SPA /login/callback).
# Defaults to VOIDSWITCH_BASE_URL — only set this if the dashboard is on a
# different origin than the gateway.
# VOIDSWITCH_FRONTEND_URL=https://voidswitch.siiway.org

# Stable secret for dashboard sessions AND at-rest credential encryption.
# Generate with: openssl rand -base64 48
# IMPORTANT: when migrating an existing deployment, this MUST be the same value
# the old gateway used, or stored provider keys / audit secrets cannot be
# decrypted. Leave blank to auto-generate per container (sessions reset on
# recreation).
VOIDSWITCH_SECRET_KEY=

# Header trusted for the real client IP in logs/audit (only the FIRST entry is
# used, matching the previous behaviour). Default X-Forwarded-For; set e.g.
# CF-Connecting-IP or X-Real-IP when your proxy forwards the client that way.
# VOIDSWITCH_CLIENT_IP_HEADER=CF-Connecting-IP

# Prism OAuth app (required for dashboard login).
VOIDSWITCH_PRISM_ISSUER=https://prism.siiway.org
VOIDSWITCH_PRISM_CLIENT_ID=your-prism-client-id
VOIDSWITCH_PRISM_CLIENT_SECRET=your-prism-client-secret

# Prism team whose owners/admins are recognised as VoidSwitch staff (main-team
# mapping). Defaults to the siiway team; override it here.
# VOIDSWITCH_MAIN_TEAM_ID=63d4761c78c2dec09a002233e1b7c06c

# PostgreSQL connection URL. The bundled compose `postgres` service is used by
# default; point this at an existing/managed Postgres instead, e.g.:
#   VOIDSWITCH_DATABASE_URL=postgres://user:pass@db-host:5432/voidswitch?sslmode=disable
# The gateway adopts an existing schema in place (no data reset) on first start.
# VOIDSWITCH_DATABASE_URL=

# Redis is required for shared rate limits, OAuth state, SSE/task leases,
# settings propagation, and routing health. The bundled Compose service is used
# by default; set this for a managed Redis deployment.
# VOIDSWITCH_REDIS_URL=redis://redis:6379/0
# Namespace keys when several VoidSwitch deployments share one Redis instance.
# VOIDSWITCH_REDIS_KEY_PREFIX=voidswitch

# Image registry/mirror prefix (default ghcr.io/siiway). Set this to pull the
# gateway + dashboard from a mirror, e.g.:
#   VS_IMAGE=hp.siiway.dpdns.org/ghcr.io/siiway
# Images are then <VS_IMAGE>/voidswitch and <VS_IMAGE>/voidswitch-dashboard.
# VS_IMAGE=ghcr.io/siiway

# Image tag to pin (default: latest). e.g. VS_IMAGE_TAG=0.3.0-2026.11.8.1
# VS_IMAGE_TAG=latest

# Build-time proxy for `docker compose build` (go mod download). Leave unset for
# a direct connection.
# HTTP_PROXY=http://YOUR_PROXY:PORT
# HTTPS_PROXY=http://YOUR_PROXY:PORT
# NO_PROXY=localhost,127.0.0.1
# GOPROXY=https://proxy.golang.org,direct

# Build context is the repo root (needed for the Go gateway image, which bundles
# backend/ + opencode-plugin/src). See backend/Dockerfile.

# --- not part of the backend image ---
frontend/
opencode-plugin/node_modules/
opencode-plugin/bun.lock
opencode-plugin/package.json
opencode-plugin/README.md
opencode-plugin/tsconfig.json
docs/
agent/

# --- Go build artifacts ---
**/*.test
backend/voidswitch/
backend/coverage.out

# --- local runtime state — must never be baked into the image ---
**/.secret_key
**/*.db
**/*.db-wal
**/*.db-shm
backend/smoke.*

# --- local config with real credentials (supply via env or a mount) ---
backend/config.yaml

# --- VCS / tooling ---
.git/
.gitignore
**/.gitignore
.dockerignore
Dockerfile
backend/Dockerfile
